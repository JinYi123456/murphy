# MURPHY environment. Every value below is read server-side only; nothing here
# reaches the browser bundle, which is why all LLM and Evolus traffic goes through
# the API routes rather than the client.

# --- AMD-hosted open-weight model (vLLM / LMDeploy / TGI OpenAI shim) ---
# Base URL of your own OpenAI-compatible inference service on the Instinct node.
# You host this; there is no account to obtain it from. Example: http://10.0.0.21:8000/v1
AMD_VLLM_BASE_URL=
# Optional bearer token for that service, if you put one behind an authenticator.
AMD_VLLM_API_KEY=
# Exact served model name, as /v1/models reports it. Example: Qwen2.5-14B-Instruct
AMD_VLLM_MODEL=
# Generation cap per call. Default 900. A compiled procedure needs the whole
# document, so leave this generous if you turn the service on.
AMD_VLLM_MAX_TOKENS=900
# Per-attempt wall clock budget, ms. Default 45000. One retry follows a 5xx or a
# timeout; 4xx responses are never retried.
AMD_VLLM_TIMEOUT_MS=45000
# Set to 1 only when your serving stack implements response_format json_object.
# When unset, JSON is requested in the prompt and parsed defensively instead.
AMD_VLLM_JSON_MODE=

# --- AMD Instinct batch engine (optional, see src/lib/gpu.ts) ---
# URL of the PyTorch/ROCm twin service. Unset means the Node engine answers, and
# the UI reports that rather than pretending otherwise. Example: http://10.0.0.21:8080
AMD_GPU_URL=

# --- Evolus platform ---
# API key from the Evolus developer console for your account.
EVOLUS_API_KEY=
# Your Evolus space / application id. Sent as X-Application-Id and used to form
# the agent chat model id "<applicationId>:<agentId>".
EVOLUS_APP_ID=
# Alternative to EVOLUS_API_KEY when calls must be attributed to a person. Sent as
# X-User-ApiKey and preferred over EVOLUS_API_KEY when both are present.
EVOLUS_USER_API_KEY=
# Workflow that approves a change order. From the workflow's URL in the Evolus
# console. A workflow that is switched off returns 409.
EVOLUS_WORKFLOW_CHANGE_ORDER=
# Agent id used both for the knowledge-library chat and as the ask-file extractor
# agent. List them with GET https://api.evolus.ai/v1/models.
EVOLUS_AGENT_ID=
# Document-extractor id belonging to EVOLUS_AGENT_ID, for SOP intake. Leave unset
# to fall back to the doc-structure AI tool.
EVOLUS_EXTRACTOR_ID=
# Knowledge library (incident and SOP documents) the agent answers from.
EVOLUS_MEMORY_LIBRARY_ID=
# Public base URL of this app, only if Evolus should call back on workflow
# completion instead of this server polling. Used as <base>/api/evolus/callback.
EVOLUS_CALLBACK_BASE_URL=
# Poll interval and total budget for workflow execution, ms. The event workspace is
# rate limited to 60 requests/minute, so do not set the interval below 1000.
EVOLUS_POLL_MS=3000
EVOLUS_POLL_TIMEOUT_MS=120000
# Request timeout for individual Evolus calls, ms.
EVOLUS_TIMEOUT_MS=60000
